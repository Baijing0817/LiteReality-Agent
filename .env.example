# --- reference image generation (required) ---
# OpenAI is the default and supported path. GOOGLE_API_KEY selects the legacy Gemini path
# instead — it still works but is off by default and unsupported.
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Blender (required) ---
# Your Blender INSTALL DIR — the folder containing the `blender` binary, not the binary itself.
BLENDER_PATH=

# --- your scans (required) ---
# Folder holding your scans. Each <scan>/ = frame_*.jpg + frame_*.json + room.usdz.
LR_SCANS_DIR=

# --- TRELLIS, image -> 3D (required: pick ONE of the two blocks below) ---
# A. RunPod serverless (recommended, no local GPU — and the only option on macOS).
#    Both values are yours: deploy the public worker once, then copy your endpoint id.
#    Steps: backends/trellis/remote/README.md
RUNPOD_TRELLIS_ENDPOINT=
RUNPOD_API_KEY=
#
# B. …or a local GPU TRELLIS install (Linux + NVIDIA only) — that env's python interpreter.
TRELLIS_PYTHON=

# --- agent CLI (optional) ---
# Reasoning/vision runs through a logged-in agent CLI; `claude` is the default. Set this only
# to pick a different one (`codex`) or a non-standard binary path.
LR_PROVIDER=

# --- detection (Linux + NVIDIA only) ---
# LEAVE EMPTY ON macOS: detection runs in-process on the Apple Silicon GPU (MPS), no CUDA to
# mismatch, nothing extra to install. On Linux+NVIDIA, point this at a torch env whose CUDA
# matches your driver — the main env's torch is often built for a newer CUDA than the driver,
# which silently falls back to CPU and is ~15x slower.
# (The detector weights come from Hugging Face; no GroundingDINO clone needed either way.)
GROUNDING_DINO_PYTHON=
