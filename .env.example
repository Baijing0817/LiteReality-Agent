# --- reference image generation (required) ---
# Hosted OpenAI reference images.
OPENAI_API_KEY=

# --- Blender (required) ---
# Your Blender INSTALL DIR — the folder containing the `blender` binary, not the binary itself.
BLENDER_PATH=

# --- your scans (required) ---
# Folder holding your scans. Each <scan>/ = frame_*.jpg + frame_*.json + room.usdz.
LR_SCANS_DIR=

# --- TRELLIS, image -> 3D (required: pick ONE of the two blocks below) ---
# A. Modal (recommended when the pipeline machine has no NVIDIA GPU).
#    Deployment details: deploy/modal/trellis/README.md
MODAL_TRELLIS_APP=
MODAL_TRELLIS_FUNCTION=generate
MODAL_DINO_APP=
MODAL_DINO_FUNCTION=infer
MODAL_ENVIRONMENT=main
MODAL_PROFILE=huangzhening

# Hosted GroundingDINO + DINOv2 endpoint. When set, detection and embeddings are API calls and
# torch is never loaded by the pipeline process.
RUNPOD_DINO_ENDPOINT=
RUNPOD_API_KEY=
#
# B. …or a local GPU TRELLIS install (Linux + NVIDIA only) — that env's python interpreter.
TRELLIS_PYTHON=

# --- isolated detection runtime ---
# Python on the machine/environment where GroundingDINO is allowed to run.
GROUNDING_DINO_PYTHON=
